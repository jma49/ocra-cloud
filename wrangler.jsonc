{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocra-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // The GitHub App "ocra Cloud dev" signs users in. Secrets (set with
  // wrangler secret put): GITHUB_CLIENT_SECRET, MASTER_KEY, SESSION_SECRET.
  "vars": { "GITHUB_CLIENT_ID": "Iv23liQIb7RBK0JvrxbN" },
  // The web app is a single-page app; the Worker answers /api first.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocra-cloud",
      "database_id": "1905b9dd-1c36-4c43-aa0f-f8b882932479",
      "migrations_dir": "migrations"
    }
  ]
}
