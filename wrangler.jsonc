{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocra-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // enable_request_signal: request.signal aborts when the client goes away,
  // so the gateway stops waiting on a provider for nobody (src/gateway.ts).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  // The product address; workers.dev stays on for development.
  "routes": [{ "pattern": "app.ocracloud.com", "custom_domain": true }],
  // Our own console messages only (never bodies, keys or tokens), one JSON
  // object each (src/log.ts), kept 3 days on the free plan. Invocation logs
  // are off: they record requests, and a request's headers carry session
  // tokens. Traces are off too: their spans record each URL in full, and the
  // sign-in callback's and the device page's carry a GitHub code and a login
  // code (audit C10).
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Daily retention (src/db/retention.ts).
  "triggers": { "crons": ["17 4 * * *", "47 * * * *"] },
  // The GitHub App "ocra Cloud dev" signs users in. Secrets (set with
  // wrangler secret put): GITHUB_CLIENT_SECRET, MASTER_KEY, SESSION_SECRET.
  // The caps are sized for the Workers Free plan, whose D1 rows and Worker
  // requests per day are shared by every account: test/quota-budget.test.ts
  // checks that five accounts at every cap use at most half of each.
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23liQIb7RBK0JvrxbN",
    // Its slug: where Repositories sends people to choose the repositories
    // it reaches (github.com/apps/<slug>/installations/new).
    "GITHUB_APP_SLUG": "ocra-cloud",
    // Model calls one account may make through the gateway in a UTC day.
    "GATEWAY_DAILY_CALLS": "500",
    // Reviews one account may upload in a UTC day (POST /api/reviews).
    "REVIEW_DAILY_UPLOADS": "50",
    // Shared findings one account may upload in the 90 days retention keeps
    // them, deleted ones included; past it a review is stored without its
    // findings. RETENTION_DAYS stays unset here: the data policy says 90.
    "REVIEW_MAX_FINDINGS": "1000",
    // Login codes (ocra login) one network (an IPv4 address, an IPv6 /64)
    // may ask for in a UTC day, and the whole service may make: they are
    // asked for before anyone signs in.
    "DEVICE_DAILY_CODES_PER_NETWORK": "20",
    "DEVICE_DAILY_CODES": "1000",
    // INSTANCE_ADMINS is not a var here: it names operators' identities, so
    // it is a Worker secret (wrangler secret put) and stays out of the repo.
    "PUBLIC_URL": "https://app.ocracloud.com"
  },
  // The web app is a single-page app; the Worker answers /api first.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Device codes an address may request (ocra login), per minute; code
  // lookups and decisions an account, and an address, may make per minute
  // (/api/device/info and /decide), so a signed-in user cannot guess codes;
  // and an account's uploads, gateway calls, key checks and settings saves
  // per minute, each kind counted apart (src/rate.ts).
  "ratelimits": [
    { "name": "DEVICE_CODES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEVICE_LOOKUPS", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "ACCOUNT_CALLS", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  // Each account's open inboxes, which webhooks tell of pull request
  // changes (src/pull-events/durable.ts). SQLite-backed, as the Free plan
  // requires; it stores nothing.
  "durable_objects": {
    "bindings": [{ "name": "PULL_EVENTS", "class_name": "PullEvents" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PullEvents"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocra-cloud",
      "database_id": "1905b9dd-1c36-4c43-aa0f-f8b882932479",
      "migrations_dir": "migrations"
    }
  ]
}
