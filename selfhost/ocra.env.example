# The server's settings (docs/self-hosting.md, Variables). Never commit the
# filled-in copy.

# How people sign in: GitHub, OpenID Connect, or both.
# The company's SSO or a self-hosted GitLab; redirect URI
# https://<OCRA_DOMAIN>/api/auth/oidc/callback, scopes openid profile email
OIDC_ISSUER=https://gitlab.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=GitLab
# Your GitHub App (docs/self-hosting.md, A GitHub App of your own); its
# callback is https://<OCRA_DOMAIN>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GitHub Enterprise Server: its address; github.com when unset.
# GITHUB_URL=https://github.example.com
# Its bot, for auto review: the App's number and private key on one line.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Who may sign in (docs/self-hosting.md, Who may sign in): anyone the
# sign-in providers vouch for when unset. Set it when a MODEL_ENDPOINTS
# entry carries the server's key, which every account then spends.
# SIGN_IN_ALLOW=org:acme,domain:acme.com,group:company/eng

# openssl rand -base64 32, each
MASTER_KEY=
SESSION_SECRET=

# To connect GitLab: an OAuth application with scope api, redirect URI
# (the sign-in's own application, with both redirect URIs and the scopes
# openid profile email api, connects GitLab when people sign in; docs/gitlab.md)
# https://<OCRA_DOMAIN>/api/platforms/gitlab/callback
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.example.com
# GitLab auto review (docs/gitlab.md): the bot's token, scope api, Developer role.
# GITLAB_BOT_TOKEN=
# A company certificate authority for GitLab or the models, placed in certs/
# (mounted at /certs): Node reads the first, git the second (docs/gitlab.md).
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
# GIT_SSL_CAINFO=/certs/company-ca.pem

# The company's own model endpoints (docs/self-hosting.md, Company models),
# and off to reach no public model provider.
# MODEL_ENDPOINTS=[{"id":"corp","label":"Corp LLM","base":"https://llm.corp.example/openai","models":"/v1/models","key":"...","prices":{"qwen3-coder":{"input":0.4,"output":1.2}}}]
# BUILTIN_PROVIDERS=off
# The models every account starts with until it saves its own. A tier left
# out (top, standard, light) takes the nearest named tier's, so one is enough.
# DEFAULT_MODELS={"top":["ocra-corp/qwen3-coder"]}

# Code graphs (docs/self-hosting.md, Code graphs): keep (default), opt-in or off.
# GitHub pushes need the App's webhook secret, its webhook URL being
# https://<OCRA_DOMAIN>/api/webhooks/github with push events.
# CODE_GRAPH=keep
# GITHUB_WEBHOOK_SECRET=
# GRAPH_WORKERS=1

# Email notifications and the daily digest (docs/self-hosting.md, Notifications).
# SMTP_URL=smtp://user:password@mail.example.com:587
# SMTP_FROM=ocra@example.com

# Slack direct messages: a Slack app's bot token with chat:write, im:write,
# users:read and users:read.email (docs/self-hosting.md, Notifications).
# SLACK_BOT_TOKEN=

# Prometheus metrics at /metrics, for this bearer token (docs/self-hosting.md,
# Health and metrics); off when unset. openssl rand -hex 32
# METRICS_TOKEN=
