# The server's settings (docs/self-hosting.md, Variables). Never commit the
# filled-in copy.

# How people sign in: GitHub, OpenID Connect, or both.
# The company's SSO or a self-hosted GitLab; redirect URI
# https://<OCRA_DOMAIN>/api/auth/oidc/callback, scopes openid profile email
OIDC_ISSUER=https://gitlab.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=GitLab
# Your GitHub App; its callback is https://<OCRA_DOMAIN>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# openssl rand -base64 32, each
MASTER_KEY=
SESSION_SECRET=

# To connect GitLab: an OAuth application with scope read_api, redirect URI
# https://<OCRA_DOMAIN>/api/platforms/gitlab/callback
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.example.com

# The company's own model endpoints (docs/self-hosting.md, Company models),
# and off to reach no public model provider.
# MODEL_ENDPOINTS=[{"id":"corp","label":"Corp LLM","base":"https://llm.corp.example/openai","models":"/v1/models","key":"..."}]
# BUILTIN_PROVIDERS=off
# The models every account starts with until it saves its own.
# DEFAULT_MODELS={"top":["ocra-corp/qwen3-coder"]}

# Code graphs (docs/self-hosting.md, Code graphs): keep (default), opt-in or off.
# GitHub pushes need the App's webhook secret, its webhook URL being
# https://<OCRA_DOMAIN>/api/graphs/webhooks/github with push events.
# CODE_GRAPH=keep
# GITHUB_WEBHOOK_SECRET=
# GRAPH_WORKERS=1

# Email notifications and the daily digest (docs/self-hosting.md, Notifications).
# SMTP_URL=smtp://user:password@mail.example.com:587
# SMTP_FROM=ocra@example.com
