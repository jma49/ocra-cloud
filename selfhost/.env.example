# Read by docker compose itself; every line may stay as it is for a trial at
# https://localhost. Copy this file to .env to change one.

# The name people open, and how Caddy gets its certificate: "internal" (its
# own authority), an ACME account email for a public name, or
# "/certs/<cert>.pem /certs/<key>.pem" for the company's certificate.
# OCRA_DOMAIN=ocra.example.com
# OCRA_TLS=internal

# The ports Caddy listens on, when 80 and 443 are taken, and then the
# address people open, with its port.
# OCRA_HTTP_PORT=80
# OCRA_HTTPS_PORT=443
# OCRA_PUBLIC_URL=https://ocra.example.com:8443

# Several ocra processes (docs/self-hosting.md, Several processes).
# COMPOSE_FILE=docker-compose.yml:docker-compose.replicas.yml
# OCRA_REPLICAS=2
