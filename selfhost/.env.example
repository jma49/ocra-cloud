# Read by docker compose itself: the name people open, and how Caddy gets its
# certificate (see Caddyfile).
OCRA_DOMAIN=ocra.example.com
OCRA_TLS=internal
# With docker-compose.postgres.yml: the password of its Postgres user, as
# letters and digits (it goes in a URL), e.g. from `openssl rand -hex 24`.
# OCRA_DB_PASSWORD=
# How many ocra processes docker-compose.replicas.yml runs.
# OCRA_REPLICAS=2
