# Read by docker compose itself: the name people open, and how Caddy gets its
# certificate (see Caddyfile).
OCRA_DOMAIN=ocra.example.com
OCRA_TLS=internal
# The files every docker compose command in this folder reads: the server on
# Postgres. Drop docker-compose.postgres.yml for a trial on a SQLite file; add
# docker-compose.replicas.yml for several processes.
COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml
# The password of the Postgres user, as letters and digits (it goes in a
# URL): `echo "OCRA_DB_PASSWORD=$(openssl rand -hex 24)" >> .env`.
# OCRA_DB_PASSWORD=
# How many ocra processes docker-compose.replicas.yml runs.
# OCRA_REPLICAS=2
