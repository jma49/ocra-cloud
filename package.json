{
  "name": "ocra-cloud",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "vite build --config web/vite.config.ts",
    "build:node": "esbuild src/node/server.ts src/node/rewrap-master-key.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "build:runner": "esbuild src/node/runner.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/runner.mjs",
    "start:runner": "node dist/runner.mjs",
    "start:node": "node dist/server.mjs",
    "check": "biome check --error-on-warnings . && node scripts/check-agents.mjs",
    "knip": "knip",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.pg.config.ts",
    "types": "wrangler types src/worker-configuration.d.ts",
    "verify": "npm run check && npm run knip && npm run typecheck && npm test && npm run build:web && npm run build:node && npm run build:runner",
    "deploy": "npm run build:web && wrangler d1 migrations apply ocra-cloud --remote && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@open-cr-agent/cli": "0.20.0",
    "@open-cr-agent/cloud-contract": "0.20.0",
    "@open-cr-agent/code-graph": "0.20.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@dynatrace-sdk/app-environment": "^1.1.6",
    "@dynatrace-sdk/client-app-engine-registry": "^3.3.1",
    "@dynatrace-sdk/client-filter-segment-management": "^1.7.1",
    "@dynatrace-sdk/client-notification-v2": "^2.5.0",
    "@dynatrace-sdk/client-platform-management-service": "^1.9.1",
    "@dynatrace-sdk/client-query": "^1.29.0",
    "@dynatrace-sdk/client-state": "^1.11.1",
    "@dynatrace-sdk/dqlint": "^1.7.0",
    "@dynatrace-sdk/error-handlers": "^1.3.3",
    "@dynatrace-sdk/navigation": "^2.3.2",
    "@dynatrace-sdk/react-hooks": "^1.15.4",
    "@dynatrace-sdk/units": "^1.5.0",
    "@dynatrace-sdk/user-preferences": "^1.1.6",
    "@dynatrace/strato-components": "^3.18.0",
    "@dynatrace/strato-design-tokens": "^1.8.1",
    "@dynatrace/strato-icons": "^2.7.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@open-cr-agent/core": "0.20.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "material-icon-theme": "5.40.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^7.1.14",
    "shiki": "4.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "packageManager": "npm@11.21.3",
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler",
      "miniflare": {
        ".": "5.20261006.1-alpha",
        "undici": "^7.30.2"
      },
      "zod": "$zod"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "@formatjs/intl": {
      "typescript": "$typescript"
    },
    "react-intl": {
      "typescript": "$typescript"
    }
  }
}
