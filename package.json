{
  "name": "ocra-cloud",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "biome check --error-on-warnings . && node scripts/check-agents.mjs",
    "knip": "knip",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "types": "wrangler types src/worker-configuration.d.ts",
    "verify": "npm run check && npm run knip && npm run typecheck && npm test && npm run build:web",
    "deploy": "npm run build:web && wrangler d1 migrations apply ocra-cloud --remote && wrangler deploy"
  },
  "dependencies": {
    "@open-cr-agent/cloud-contract": "0.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "knip": "^6.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  },
  "packageManager": "npm@10.9.9",
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler",
      "miniflare": "5.20261006.1-alpha"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
