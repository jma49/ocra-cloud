{
  "name": "ocra-cloud",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "vite build --config web/vite.config.ts",
    "build:node": "esbuild src/node/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start:node": "node dist/server.mjs",
    "check": "biome check --error-on-warnings . && node scripts/check-agents.mjs",
    "knip": "knip",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.pg.config.ts",
    "types": "wrangler types src/worker-configuration.d.ts",
    "verify": "npm run check && npm run knip && npm run typecheck && npm test && npm run build:web && npm run build:node",
    "deploy": "npm run build:web && wrangler d1 migrations apply ocra-cloud --remote && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@open-cr-agent/cloud-contract": "0.9.0",
    "@open-cr-agent/code-graph": "0.9.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "kubai-icons-react": "^0.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "packageManager": "npm@11.21.3",
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler",
      "miniflare": {
        ".": "5.20261006.1-alpha",
        "undici": "^7.30.2"
      },
      "zod": "$zod"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
